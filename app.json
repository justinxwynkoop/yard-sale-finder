{
  "expo": {
    "name": "Trove",
    "slug": "yard-sale-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "trove",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2E8"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.jwynkoop.trove",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:trove.sale"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trove uses your location to center the map on yard sales near you and show how far away each sale is — for example, sorting nearby sales by driving distance.",
        "NSPhotoLibraryUsageDescription": "Trove accesses your photo library so you can choose existing photos of items you're selling — for example, adding pictures of furniture or tools to your sale or listing — and to set your profile photo.",
        "NSCameraUsageDescription": "Trove uses the camera so you can photograph items you're selling — for example, snapping pictures of furniture or tools to add to your yard sale post or item listing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F2E8"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F7F2E8"
      },
      "package": "com.jwynkoop.trove",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA7o8V5v2nDkJsu2q3K_2jDZwKg-WZG6E8"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1F4D3A",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trove uses your location to center the map on yard sales near you and show how far away each sale is — for example, sorting nearby sales by driving distance.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Trove uses the camera so you can photograph items you're selling — for example, snapping pictures of furniture or tools to add to your yard sale post or item listing."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "organization": "trove-b0f",
          "project": "trove",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2E8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "21cc3271-4b50-4f32-a4e4-6823f78ec3e7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/21cc3271-4b50-4f32-a4e4-6823f78ec3e7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "owner": "jasonwynkoop1"
  }
}
