{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/\\.well-known/apple-app-site-association$",
      "headers": { "Content-Type": "application/json" },
      "dest": "/.well-known/apple-app-site-association"
    },
    { "handle": "filesystem" },
    { "src": "^/sale/([^/]+)$", "dest": "/api/share-page?type=sale&id=$1" },
    { "src": "^/listing/([^/]+)$", "dest": "/api/share-page?type=listing&id=$1" },
    { "src": "^/sitemap\\.xml$", "dest": "/api/sitemap" },
    { "src": "^/event/[a-z0-9]+$", "dest": "/open.html" },
    { "src": "^/privacy$", "dest": "/privacy.html" },
    { "src": "^/delete-account$", "dest": "/delete-account.html" },
    { "src": "^/terms$", "dest": "/terms.html" },
    { "src": "^/open$", "dest": "/open.html" },
    { "src": "^/ops$", "dest": "/ops.html" }
  ]
}
